  "road": "road",
  "description": {
    "fr": "Conçu à des fins scientifiques, le projet d'arche à biosphère gigantesque permet l'existence de plusieurs écosystèmes dans une installation fermée et auto-régulée. Les scientifiques du monde entier s'y rassemblent pour faire part de leurs idées uniques sur la planète.",
    "en": "Built for scientific purposes, the gigantic Arc biosphere project offers a set of different ecosystems in a closed, self-regulated facility. Scientists from all around the world gather to contribute unique insights into our planet."
  },
  "boosts": [
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_guild_goods-e1fb74f07.png",
      "name": {
        "fr": "Ressources de la guilde",
        "en": "Guild Goods"
      },
      "text": {
        "fr": "Produit une certaine quantité de chaque ressource actuelle pour la trésorerie de la guilde. Ne se collecte qu'en étant membre d'une guilde.",
        "en": "Produces some of each current good for the guild's treasury. Can only be collected when in a guild."
      }
    },
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_contribution_boost-90fde6ed1.png",
      "name": {
        "fr": "Bonus de contribution",
        "en": "Contribution Boost"
      },
      "text": {
        "fr": "Les récompenses de contribution augmentent d'un certain pourcentage.",
        "en": "Contribution Rewards are increased by a percentage."
      }
    }
  ],
