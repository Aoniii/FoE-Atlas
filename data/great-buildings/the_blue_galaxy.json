  "description": {
    "fr": "La galaxie bleue possède la collection de méduses la plus complète de toute la planète. Elle permet aussi à ses visiteurs de découvrir la sensation d'être dans les profondeurs bleues.",
    "en": "The Blue Galaxy has the world's most complete collection of jellyfish. It also lets its visitors experience the wonder of being deep in the blue depths."
  },
  "boosts": [
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_medals-d29e77a05.png",
      "name": {
        "fr": "Production de médailles",
        "en": "Medal production"
      },
      "text": {
        "fr": "Produit Médailles toutes les 24 heures.",
        "en": "Produces Medals every 24 hours."
      }
    },
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_double_collect-d6be5219d.png",
      "name": {
        "fr": "Collecte doublée",
        "en": "Double Collection"
      },
      "text": {
        "fr": "Pour les premiers bâtiments collectés, il y a une chance de doubler les richesses obtenues. Ne concerne pas les bâtiments militaires et grands monuments.",
        "en": "For the first number of buildings collected, there is a chance the collection is doubled. Excludes military and great buildings."
      }
    }
