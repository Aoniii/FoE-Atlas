  "road": "road",
  "description": {
    "fr": "Cette tour en pierre médiévale servait à surveiller le port de la Corne d'Or, à Istanbul. Après la conquête de Constantinople en 1453, la tour a été utilisée pour repérer les incendies dans la cité.",
    "en": "This medieval stone tower was utilized for surveillance of the harbor in the Golden Horn, Istanbul. After the conquest of Constantinople in 1453, the tower was used to detect fires in the city."
  },
  "boosts": [
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_goods-ecf3d9439.png",
      "name": {
        "fr": "Production de ressources",
        "en": "Good production"
      },
      "text": {
        "fr": "Produit des ressources aléatoires de l'âge du joueur toutes les 24 heures. À partir de l'Ère Moderne, produit deux fois plus de ressources non raffinées.",
        "en": "Produces random goods from the players age every 24 hours. From Modern Era onwards produces twice as many unrefined goods instead."
      }
    },
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_plunder_repel-74e9ea181.png",
      "name": {
        "fr": "Résistance au pillage",
        "en": "Plunder Repel"
      },
      "text": {
        "fr": "Les premières tentatives de pillage que nous subissons ont une chance d'être repoussées.",
        "en": "The first number of suffered plunder attempts have a chance of being repelled."
      }
    }
  ],
