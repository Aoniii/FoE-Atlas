  "id": "lighthouse_of_alexandria",
  "name": {
    "fr": "Phare d'Alexandrie",
    "en": "Lighthouse of Alexandria"
  },
  "image": "https://foeen.innogamescdn.com/assets/city/buildings/X_SS_IronAge_Landmark2-9515d0e55.png",
  "age": "IronAge",
