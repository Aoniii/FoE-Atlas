{
  "id": "observatory",
  "name": {
    "fr": "Observatoire",
    "en": "Observatory"
  },
  "image": "https://foeen.innogamescdn.com/assets/city/buildings/X_SS_AllAge_EasterBonus4-870c88d53.png",
  "size": {
    "w": 3,
    "h": 3
  },
  "road": "road",
  "description": {
    "fr": "Initialement construit pour observer les phénomènes célestes, l'imposant observatoire permet d'acquérir des connaissances d'une valeur incomparable pour les alliances. Au-delà de l'observation des étoiles et du ciel, surveiller ce qu'il se passe au sol permet de détecter plus facilement les nouvelles ressources et de prendre de l'avance sur les concurrents.",
    "en": "Originally built to look at celestial events, the towering Observatory gathers knowledge that proves to be unrivaled in its value for alliances. Aside from watching the stars and the sky, monitoring terrestrial events helps to detect new resources and to gain an edge over the competitors."
  },
  "boosts": [
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_guild_goods-e1fb74f07.png",
      "name": {
        "fr": "Ressources de la guilde",
        "en": "Guild Goods"
      },
      "text": {
        "fr": "Produit une certaine quantité de chaque ressource actuelle pour la trésorerie de la guilde. Ne se collecte qu'en étant membre d'une guilde.",
        "en": "Produces some of each current good for the guild's treasury. Can only be collected when in a guild."
      }
    },
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/att_def_boost_defender-6e0afd1e0.png",
      "name": {
        "fr": "Défenseurs - Attaque et défense",
        "en": "Defenders - Attack & Defense"
      },
      "text": {
        "fr": "Les unités de défense voient leurs valeurs d'attaque et de défense améliorées d'un certain pourcentage.",
        "en": "Defending units have their attack and defense values boosted by a percentage."
      }
    }
  ],
