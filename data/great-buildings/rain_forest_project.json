{
  "id": "rain_forest_project",
  "name": {
    "fr": "Forêt tropicale",
    "en": "Rain Forest Project"
  },
  "image": "https://foeen.innogamescdn.com/assets/city/buildings/X_SS_FutureEra_Landmark2-e86a8f415.png",
  "age": "FutureEra",
  "size": {
    "w": 6,
    "h": 6
  },
  "road": "road",
  "description": {
    "fr": "Pour combattre des catastrophes telles que les incendies ou les sécheresses, l'énorme gratte-ciel de la forêt tropicale recueille l'eau de pluie. Cette structure unique fonctionne avec l'aide de personnes de différents pays du monde, qui bénéficient à leur tour de nombreuses découvertes scientifiques.",
    "en": "To battle natural disasters like fires or droughts, the massive Rain Forest Project skyscraper harvests and collects rainwater. The unique structure is operated with the aid of people from different countries from all around the world, that in return benefit from a wide range of scientific learnings."
  },
  "boosts": [
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_goods-ecf3d9439.png",
      "name": {
        "fr": "Production de ressources",
        "en": "Good production"
      },
      "text": {
        "fr": "Produit des ressources aléatoires de l'âge du joueur toutes les 24 heures. À partir de l'Ère Moderne, produit deux fois plus de ressources non raffinées.",
        "en": "Produces random goods from the players age every 24 hours. From Modern Era onwards produces twice as many unrefined goods instead."
      }
    },
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_aid_blueprints-8d0c2d633.png",
      "name": {
        "fr": "Plans d'entraide",
        "en": "Aid Blueprints"
      },
      "text": {
        "fr": "Augmente la chance de trouver un plan en aidant un autre joueur.",
        "en": "Increased chance of finding a blueprint when aiding another player."
      }
    }
  ],
