{
  "id": "atlantis_museum",
  "name": {
    "fr": "Musée de l'Atlantide",
    "en": "Atlantis Museum"
  },
  "image": "https://foeen.innogamescdn.com/assets/city/buildings/X_SS_OceanicFuture_Landmark1-f81626456.png",
  "age": "OceanicFuture",
  "size": {
    "w": 7,
    "h": 6
  },
  "road": "road",
  "description": {
    "fr": "Autrefois un imposant monument dédié à la puissance dévastatrice de son empire, il a été récemment redécouvert et transformé en un musée populaire. Certains pensent qu'il s'agit de la seule preuve concrète de l'existence de l'Atlantide, ce qui suffit à entretenir le mythe.",
    "en": "Once a fearless monument to the plunderous might of its empire, recently it was rediscovered and converted into a popular museum. Some consider it to be the only concrete proof of Atlantis' existence, enough to keep the myth alive."
  },
  "boosts": [
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_goods-ecf3d9439.png",
      "name": {
        "fr": "Production de ressources",
        "en": "Good production"
      },
      "text": {
        "fr": "Produit des ressources aléatoires de l'âge du joueur toutes les 24 heures. À partir de l'Ère Moderne, produit deux fois plus de ressources non raffinées.",
        "en": "Produces random goods from the players age every 24 hours. From Modern Era onwards produces twice as many unrefined goods instead."
      }
    },
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_plunder_and_pillage-b57d09b6c.png",
      "name": {
        "fr": "Pillage et saccage",
        "en": "Plunder and Pillage"
      },
      "text": {
        "fr": "Ajoute une chance de doubler les richesses pillées.",
        "en": "Adds a chance of doubling plundered resources."
      }
    }
  ],
