  "id": "cosmic_catalyst",
  "name": {
    "fr": "Catalyseur cosmique",
    "en": "Cosmic Catalyst"
  },
  "image": "https://foeen.innogamescdn.com/assets/city/buildings/X_SS_SpaceAgeSpaceHub_Landmark2-683a3a207.png",
  "age": "SpaceAgeSpaceHub",
