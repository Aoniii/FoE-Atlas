    "w": 4,
    "h": 4
  },
  "road": "road",
  "description": {
    "fr": "Nombreux sont ceux qui n'ont pas réussi à construire un catalyseur aussi magnifique. Il s'agit sans aucun doute de la deuxième pierre angulaire de la domination intergalactique. Rares sont ceux qui savent le construire, et encore plus rares sont ceux qui savent le faire fonctionner.",
    "en": "Many have failed to build such a magnificent Catalyst. It is without a doubt the second cornerstone of intergalactic dominance. Only a few know how to build it, and even less how to operate it."
  },
  "boosts": [
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_guild_goods-e1fb74f07.png",
      "name": {
        "fr": "Ressources de la guilde",
        "en": "Guild Goods"
      },
      "text": {
        "fr": "Produit une certaine quantité de chaque ressource actuelle pour la trésorerie de la guilde. Ne se collecte qu'en étant membre d'une guilde.",
        "en": "Produces some of each current good for the guild's treasury. Can only be collected when in a guild."
      }
    },
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_critical_hit_chance-2b5603a4b.png",
      "name": {
        "fr": "Coup critique",
        "en": "Critical Hit"
      },
      "text": {
        "fr": "Accorde une chance d'infliger 150% de points de dégâts aux unités ennemies du même âge que vos unités. Cap à 25%.",
        "en": "Grants a chance to deal 150% damage against enemy units from the same Age as your units. Caps at 25%."
      }
    }
  ],
