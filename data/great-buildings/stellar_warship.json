{
  "id": "stellar_warship",
  "name": {
    "fr": "Vaisseau de guerre stellaire",
    "en": "Stellar Warship"
  },
  "image": "https://foeen.innogamescdn.com/assets/city/buildings/X_SS_SpaceAgeSpaceHub_Landmark1-1d9cc8d89.png",
  "age": "SpaceAgeSpaceHub",
