        "en": "Research"
      },
      "text": {
        "fr": "Produit Points Forge toutes les 24 heures.",
        "en": "Produces Forge Points every 24 hours."
      }
    },
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_critical_hit_chance-2b5603a4b.png",
      "name": {
        "fr": "Coup critique",
        "en": "Critical Hit"
      },
      "text": {
        "fr": "Accorde une chance d'infliger 150% de points de dégâts aux unités ennemies du même âge que vos unités.",
        "en": "Grants a chance to deal 150% damage against enemy units from the same Age as your units."
      }
    }
  ],
