  "id": "arctic_orangery",
  "name": {
    "fr": "Orangerie arctique",
    "en": "Arctic Orangery"
  },
  "image": "https://foeen.innogamescdn.com/assets/city/buildings/X_SS_ArcticFuture_Landmark2-3d057618a.png",
