  "description": {
    "fr": "Portant le nom d'Albert, prince consort de la reine Victoria du Royaume-Uni, le Royal Albert Hall accueille les plus importants événements culturels de Grande-Bretagne. Son atmosphère et sa réputation ne cessent d'attirer les plus grands artistes de la planète.",
    "en": "Named after Albert, Prince Consort to Queen Victoria of the United Kingdom, the Royal Albert Hall hosts some of the most important cultural events in Britain. Its atmosphere and reputation continue to attract the finest artistic minds on the planet."
  },
  "boosts": [
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_goods-ecf3d9439.png",
      "name": {
        "fr": "Production de ressources",
        "en": "Good production"
      },
      "text": {
        "fr": "Produit des ressources aléatoires de l'âge du joueur toutes les 24 heures. À partir de l'Ère Moderne, produit deux fois plus de ressources non raffinées.",
        "en": "Produces random goods from the players age every 24 hours. From Modern Era onwards produces twice as many unrefined goods instead."
      }
    },
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_supplies-d07694640.png",
      "name": {
        "fr": "Amélioration marchandises",
        "en": "Supply boost"
      },
      "text": {
        "fr": "Les premières collectes de production de Marchandises sont augmentées d'un certain pourcentage.",
        "en": "The first number of collected Supplies productions are boosted by a percentage."
      }
    }
  ],
