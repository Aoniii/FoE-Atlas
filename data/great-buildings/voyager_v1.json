      "name": {
        "fr": "Ressources de pillage",
        "en": "Plunder Goods"
      },
      "text": {
        "fr": "Lors de vos premiers pillages d'un bâtiment, vous recevez une ressource aléatoire de l'âge du bâtiment.",
        "en": "The first number of times you plunder a building you get a random good from that building's age."
      }
    }
