    "w": 7,
    "h": 4
  },
  "road": "road",
  "description": {
    "fr": "Le transporteur spatial relie les cités tout autour du globe et même sur d'autres planètes. Les communications améliorées augmentent les richesses de notre cité principale.",
    "en": "The Space Carrier connects cities all around the globe and even other planets. Thus, better communication increases the resources in our main city."
  },
  "boosts": [
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_special_goods-ce3ff4ea1.png",
      "name": {
        "fr": "Navette orbitale",
        "en": "Orbital Transfer"
      },
      "text": {
        "fr": "Produit des ressources spéciales toutes les 24 heures après avoir atteint le Futur arctique. Les chances et types de ressources spéciales varient dans les âges ultérieurs au Futur arctique. Produit des médailles des âges précédents.",
        "en": "Produces special resources every 24 hours after reaching Arctic Future. The chances and types of special resources vary in the eras after Arctic Future. Produces medals in previous eras."
      }
    },
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_diplomatic_gifts-855d0b0bf.png",
      "name": {
        "fr": "Cadeaux diplomatiques",
        "en": "Diplomatic Gifts"
      },
      "text": {
        "fr": "Les premières combinaisons réussies lors d'une négociation (colonies exclues) ont une chance de vous octroyer une récompense aléatoire.",
        "en": "The first number of victorious negotiation combination games (excluding settlements) have a chance of providing you with a random reward."
      }
    }
  ],
