{
  "id": "a_i_core",
  "name": {
    "fr": "Noyau d'I.A.",
    "en": "A.I. Core"
  },
  "image": "https://foeen.innogamescdn.com/assets/city/buildings/X_SS_SpaceAgeJupiterMoon_Landmark1-bec190586.png",
  "age": "SpaceAgeJupiterMoon",
  "size": {
    "w": 5,
    "h": 5
  },
  "road": "road",
  "description": {
    "fr": "Le noyau d'I.A. est un superordinateur central traitant une énorme quantité de données. Il a été créé pour identifier et analyser toutes les ressources produites, collectées et importées. Grâce à ses algorithmes d'apprentissage profond uniques, il peut augmenter la productivité des ressources spéciales de votre cité principale.",
    "en": "The A.I. Core is a central supercomputer, processing massive amounts of data. It was created to identify and analyze produced, collected, and imported goods of any type. Due to its unique deep-learning algorithms, it can increase the special goods productivity of your main city."
  },
  "boosts": [
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_guild_goods-e1fb74f07.png",
      "name": {
        "fr": "Ressources de la guilde",
        "en": "Guild Goods"
      },
      "text": {
        "fr": "Produit une certaine quantité de chaque ressource actuelle pour la trésorerie de la guilde. Ne se collecte qu'en étant membre d'une guilde.",
        "en": "Produces some of each current good for the guild's treasury. Can only be collected when in a guild."
      }
    },
    {
      "icon": "https://foeen.innogamescdn.com/assets/shared/icons/icon_great_building_bonus_algorithmic_core-c5a6b5ba1.png",
      "name": {
        "fr": "Noyau algorithmique",
        "en": "Algorithmic Core"
      },
      "text": {
        "fr": "Améliore les premières collectes de ressources spéciales des productions après avoir atteint le Futur arctique. Améliore les marchandises des ères précédentes à la place.",
        "en": "Boosts the first special good collections from productions after reaching Arctic Future. Boosts supplies in earlier eras instead."
      }
    }
  ],
