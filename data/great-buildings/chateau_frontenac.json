      "name": {
        "fr": "Bonus de récompense de quête",
        "en": "Quest Reward Boost"
      },
      "text": {
        "fr": "Les pièces, marchandises, ressources, diamants et médailles reçus en guise de récompenses de quête sont augmentés d'un certain pourcentage.",
        "en": "When you get coins, supplies, goods, diamonds or medals as rewards from quests, you receive an additional percentage on top."
      }
    }
  ],
