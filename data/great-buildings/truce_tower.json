      "name": {
        "fr": "Ressources d'entraide",
        "en": "Aid Goods"
      },
      "text": {
        "fr": "Les premières fois que vous aidez un bâtiment, vous recevez une ressource aléatoire de l'âge du bâtiment.",
        "en": "The first number of times you aid a building you get a random good from that building's age."
      }
    }
